{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with salary and financial preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "monthlySalary": { "type": "integer", "description": "Monthly net salary in COP" },
        "currency": { "type": "string", "description": "Currency code like COP" },
        "displayName": { "type": "string", "description": "User display name" },
        "customCategories": { "type": "array", "items": { "type": "string" }, "description": "Custom user categories" },
        "showSavingsTab": { "type": "boolean", "description": "Whether the Savings tab is visible in the bottom bar (defaults to true)" },
        "hiddenTabs": { "type": "array", "items": { "type": "string" }, "description": "Tab keys hidden from the bottom bar (empty means all visible)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "monthlySalary", "currency", "createdAt", "updatedAt"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly budget overview and summary",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "monthKey": { "type": "string", "description": "Month in YYYY-MM format" },
        "salary": { "type": "integer", "description": "Salary allocated for this month" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "monthKey", "salary", "createdAt", "updatedAt"]
    },
    "BudgetItem": {
      "title": "BudgetItem",
      "description": "Individual budget expense item with check-off status",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "monthKey": { "type": "string", "description": "Month in YYYY-MM format" },
        "name": { "type": "string", "description": "Item name" },
        "amount": { "type": "integer", "description": "Amount in COP" },
        "category": { "type": "string", "description": "Budget category" },
        "isPaid": { "type": "boolean", "description": "Whether this item has been paid this month" },
        "isRecurring": { "type": "boolean", "description": "Whether this item repeats monthly or is one-time" },
        "paidAt": { "type": "string", "format": "date-time", "description": "Optional timestamp when paid" },
        "notes": { "type": "string", "description": "Optional notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "monthKey", "name", "amount", "category", "isPaid", "createdAt", "updatedAt"]
    },
    "TemplateItem": {
      "title": "TemplateItem",
      "description": "Default template item copied to new months",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Item name" },
        "amount": { "type": "integer", "description": "Amount in COP" },
        "category": { "type": "string", "description": "Budget category" },
        "isRecurring": { "type": "boolean", "description": "Whether this item is recurring" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "name", "amount", "category", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Financial advisor chat message",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "role": { "type": "string", "enum": ["user", "model"], "description": "Message sender role" },
        "text": { "type": "string", "description": "Message text content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["userId", "role", "text", "createdAt"]
    },
    "SavingsPocket": {
      "title": "SavingsPocket",
      "description": "Independent personal or partner-shared savings pocket",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Creator user ID" },
        "memberUids": { "type": "array", "items": { "type": "string" }, "description": "Authorized member UIDs (max 10)" },
        "memberNames": { "type": "object", "description": "Map of UID to display name for pocket members" },
        "name": { "type": "string", "description": "Pocket title" },
        "currentAmount": { "type": "integer", "description": "Current accumulated balance in COP" },
        "targetAmount": { "type": "integer", "description": "Optional savings goal amount in COP" },
        "iconKey": { "type": "string", "description": "Selected icon identifier" },
        "colorKey": { "type": "string", "description": "Selected theme color identifier" },
        "shareCode": { "type": "string", "description": "Optional active invite code" },
        "shareCodeExpiresAt": { "type": "string", "format": "date-time", "description": "Optional invite code expiration timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["ownerId", "memberUids", "name", "currentAmount", "iconKey", "colorKey", "createdAt", "updatedAt"]
    },
    "PocketMovement": {
      "title": "PocketMovement",
      "description": "Immutable deposit or withdrawal record inside a savings pocket",
      "type": "object",
      "properties": {
        "pocketId": { "type": "string", "description": "Parent savings pocket ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "initial"], "description": "Movement direction" },
        "amount": { "type": "integer", "description": "Positive movement amount in COP" },
        "balanceAfter": { "type": "integer", "description": "Pocket balance after this movement" },
        "note": { "type": "string", "description": "Optional note" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["pocketId", "userId", "userName", "type", "amount", "balanceAfter", "createdAt"]
    },
    "PocketInvite": {
      "title": "PocketInvite",
      "description": "Temporary invite code lookup document for joining a shared savings pocket",
      "type": "object",
      "properties": {
        "pocketId": { "type": "string", "description": "Target savings pocket ID" },
        "pocketName": { "type": "string", "description": "Target pocket name" },
        "ownerId": { "type": "string", "description": "Pocket creator UID" },
        "ownerName": { "type": "string", "description": "Pocket creator display name" },
        "isActive": { "type": "boolean", "description": "Whether the invite code can currently be redeemed" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Expiration timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["pocketId", "pocketName", "ownerId", "ownerName", "isActive", "expiresAt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles with salary configuration"
    },
    "/users/{userId}/months/{monthKey}": {
      "schema": "MonthlyBudget",
      "description": "Monthly budget records"
    },
    "/users/{userId}/months/{monthKey}/items/{itemId}": {
      "schema": "BudgetItem",
      "description": "Checklist items for each month"
    },
    "/users/{userId}/templateItems/{itemId}": {
      "schema": "TemplateItem",
      "description": "Default recurring items used as monthly budget template"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Financial advice conversational history"
    },
    "/savingsPockets/{pocketId}": {
      "schema": "SavingsPocket",
      "description": "Personal and partner-shared savings pockets"
    },
    "/savingsPockets/{pocketId}/movements/{movementId}": {
      "schema": "PocketMovement",
      "description": "Immutable savings pocket deposit/withdrawal history"
    },
    "/pocketInvites/{inviteCode}": {
      "schema": "PocketInvite",
      "description": "Temporary regenerable invite codes for joining shared pockets"
    }
  }
}
